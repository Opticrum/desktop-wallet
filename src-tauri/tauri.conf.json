{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Opticrum Desktop",
  "version": "0.1.0",
  "identifier": "com.opticrum.wallet",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm --prefix app run dev",
    "beforeBuildCommand": "npm --prefix app run build"
  },
  "app": {
    "windows": [
      {
        "title": "Opticrum Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
